# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Site URL ──────────────────────────────────────────────────────────────────
# This is used as the base for OAuth redirectTo and password reset links.
# In production this should be your Vercel domain (no trailing slash).
# In local dev set it to http://localhost:3000
#
# Production:
NEXT_PUBLIC_SITE_URL=https://academy-lms-xi.vercel.app
# Local:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Notes ─────────────────────────────────────────────────────────────────────
# After adding/changing these, also update the Supabase Dashboard:
#   Authentication → URL Configuration → Site URL
#     → https://academy-lms-xi.vercel.app
#
#   Authentication → URL Configuration → Redirect URLs (add ALL of these):
#     → https://academy-lms-xi.vercel.app/auth/callback
#     → https://academy-lms-xi.vercel.app/auth/reset-password
#     → http://localhost:3000/auth/callback       ← for local dev
#     → http://localhost:3000/auth/reset-password ← for local dev
